# Database Configuration (TiDB Cloud / MySQL-compatible)
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DB=test

# Application Security
# Set a strong 32+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_random_string_32_characters
PASSWORD_SALT=your_custom_salt_optional

# System Thresholds & CORS
MOISTURE_THRESHOLD=50
ALLOWED_ORIGIN=*

# SMTP Configuration (Gmail App Password)
# Host untuk Gmail: smtp.gmail.com, Port: 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
# Password aplikasi 16 karakter dari Google Account (bukan password login biasa)
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM=PlantCare IoT <emailkamu@gmail.com>

